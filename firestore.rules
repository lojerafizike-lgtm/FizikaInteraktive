rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}
    // Fields:
    //   - email: string (required)
    //
    // Collection: profiles/{userId}
    // Fields:
    //   - displayName: string (required)
    //   - photoURL: string (optional)
    //   - totalScore: number (required)
    //   - lastUpdated: timestamp (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "lojerafizike@gmail.com" && request.auth.token.email_verified == true));
    }

    // Domain Validators
    function isValidUserPrivate(data) {
      return data.keys().hasOnly(['email']) &&
             data.email is string && data.email.size() > 0;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'totalScore']) &&
             data.keys().hasOnly(['displayName', 'photoURL', 'totalScore', 'lastUpdated']) &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.totalScore is number &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500));
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserPrivate(request.resource.data);
      allow update: if isOwner(userId) && isValidUserPrivate(request.resource.data);
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      // Publicly readable for leaderboard
      allow read: if true;
      
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.totalScore == 0;
      
      allow update: if isAuthenticated() && (
        // Owner can update their own profile/score
        (isOwner(userId) && isValidUserProfile(request.resource.data)) ||
        // Admin can update anything
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }
  }
}
