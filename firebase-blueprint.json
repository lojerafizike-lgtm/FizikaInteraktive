{
  "entities": {
    "Material": {
      "title": "Material",
      "description": "A study or teaching material.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" }
      },
      "required": ["type", "topic", "title", "authorId", "authorName", "createdAt", "fileUrl", "fileName"]
    },
    "Note": {
      "title": "Note",
      "description": "A student's physics note.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "planet": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "collaborators": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["userId", "title", "content", "planet", "createdAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public user profile.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "school": { "type": "string" },
        "role": { "type": "string", "enum": ["mesues", "nxenes", "admin"] },
        "photoURL": { "type": "string" },
        "totalScore": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "PrivateUser": {
      "title": "PrivateUser",
      "description": "Private user information.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Collection of learning materials."
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Collection of user notes."
    },
    "/profiles/{userId}": {
      "schema": "Profile",
      "description": "Public user profiles."
    },
    "/users/{userId}": {
      "schema": "PrivateUser",
      "description": "Private user data."
    }
  }
}
