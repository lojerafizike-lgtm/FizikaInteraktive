rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- VALIDATION HELPERS ---
    function isValidNote(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'planet', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 100000 &&
             data.planet is string &&
             data.createdAt == request.time;
    }

    function isValidProfile(data) {
      return (data.keys().hasAny(['displayName', 'photoURL', 'totalScore', 'lastUpdated']) || 
              data.keys().hasAny(['username', 'school', 'role'])) &&
             (data.get('displayName', '') is string) &&
             (data.get('photoURL', '') is string) &&
             (data.get('username', '') is string) &&
             (data.get('school', '') is string) &&
             (data.get('role', 'nxenes') in ['mesues', 'nxenes', 'admin']) &&
             (data.get('totalScore', 0) is number);
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['type', 'topic', 'title', 'authorId', 'authorName', 'createdAt', 'fileUrl', 'fileName']) &&
             data.type is string &&
             data.topic is string &&
             data.title is string && data.title.size() <= 200 &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.createdAt == request.time &&
             data.fileUrl is string && 
             data.fileName is string;
    }

    // --- COLLECTIONS ---

    match /materials/{materialId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidMaterial(incoming());
      allow update: if isSignedIn() && isOwner(existing().authorId) && isValidMaterial(incoming()) && incoming().authorId == existing().authorId;
      allow delete: if isSignedIn() && isOwner(existing().authorId);
    }

    match /notes/{noteId} {
      function isCollaborator() {
        return isSignedIn() && (request.auth.uid in resource.data.collaborators || request.auth.token.email in resource.data.collaborators);
      }

      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isCollaborator());
      allow create: if isSignedIn() && isValidNote(incoming());
      allow update: if isSignedIn() && (isOwner(resource.data.userId) || isCollaborator()) && 
                     (incoming().userId == existing().userId); // Prevent ownership transfer
      allow delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow leaderboard listing
      allow create: if isSignedIn() && isOwner(userId) && isValidProfile(incoming());
      allow update: if isSignedIn() && (isOwner(userId)) && isValidProfile(incoming());
    }

    match /users/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }
  }
}
