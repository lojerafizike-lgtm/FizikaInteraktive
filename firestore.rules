rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}
    // Fields:
    //   - email: string (required)
    //
    // Collection: profiles/{userId}
    // Fields:
    //   - displayName: string (required)
    //   - username: string (optional)
    //   - role: string (optional, 'mesues' or 'nxenes')
    //   - school: string (optional)
    //   - photoURL: string (optional)
    //   - totalScore: number (required)
    //   - lastUpdated: timestamp (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "lojerafizike@gmail.com" && request.auth.token.email_verified == true));
    }

    function isTeacher() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'mesues';
    }

    // Domain Validators
    function isValidUserPrivate(data) {
      return data.keys().hasOnly(['email']) &&
             data.email is string && data.email.size() > 0;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'totalScore']) &&
             data.keys().hasOnly(['displayName', 'username', 'role', 'school', 'photoURL', 'totalScore', 'lastUpdated']) &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.totalScore is number &&
             (!('username' in data) || (data.username is string && data.username.size() < 50)) &&
             (!('role' in data) || (data.role in ['mesues', 'nxenes'])) &&
             (!('school' in data) || (data.school is string && data.school.size() < 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500));
    }

    function isValidMaterial(data) {
      return data.keys().hasAll(['type', 'topic', 'title', 'authorId', 'authorName', 'createdAt']) &&
             data.keys().hasOnly(['type', 'topic', 'title', 'authorId', 'authorName', 'createdAt', 'fileUrl']) &&
             data.type is string && data.topic is string && data.title is string &&
             data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.createdAt is timestamp;
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUserPrivate(request.resource.data);
      allow update: if isOwner(userId) && isValidUserPrivate(request.resource.data);
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      // Publicly readable for leaderboard
      allow read: if true;
      
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.totalScore == 0;
      
      allow update: if isAuthenticated() && (
        // Owner can update their own profile/score
        (isOwner(userId) && isValidUserProfile(request.resource.data)) ||
        // Admin can update anything
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if true;
      allow create: if isTeacher() && isValidMaterial(request.resource.data);
      allow update: if (isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid)) && isValidMaterial(request.resource.data);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
  }
}
