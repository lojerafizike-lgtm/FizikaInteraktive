{
  "entities": {
    "UserPrivate": {
      "title": "User Private",
      "description": "Private data for a user.",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Public profile and score for the leaderboard.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["mesues", "nxenes"] },
        "school": { "type": "string" },
        "photoURL": { "type": "string" },
        "totalScore": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "totalScore"]
    },
    "Material": {
      "title": "Material",
      "description": "Educational material added by a teacher.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "topic": { "type": "string" },
        "title": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" }
      },
      "required": ["type", "topic", "title", "authorId", "authorName", "createdAt", "fileUrl", "fileName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserPrivate",
      "description": "Private user data."
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profiles for leaderboard."
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Collection of educational materials."
    }
  }
}
